# --- Database ---
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=portfolio
# When the app runs in docker-compose, host is the service name "db".
# For local `prisma migrate` from the host, use localhost:5432.
DATABASE_URL=postgresql://portfolio:change_me_in_production@db:5432/portfolio?schema=public

# --- App ---
# Public base URL — used for canonical links, sitemap, OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# --- Auth ---
# Secret used to sign session cookies (min 32 chars). Generate: openssl rand -base64 48
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# --- Storage ---
# Local uploads dir (mounted as a docker volume in production).
UPLOADS_DIR=./uploads
# Public path prefix where uploads are served.
UPLOADS_PUBLIC_PREFIX=/uploads

# --- Seed admin (used by `npm run create:admin` / seed) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password

COMPOSE_PROJECT_NAME=portfolio
RUN_SEED=false
BACKUP_KEEP_DAYS=14

# --- Web Push (VAPID) — уведомления админа при закрытом PWA (опционально) ---
# Сгенерировать пару: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@keereal.dev
